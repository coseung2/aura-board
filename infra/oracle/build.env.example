# Build-time values only. Never copy production credentials into this file.
# Replace placeholders only when Next.js or Prisma validation requires a value.
NODE_ENV=production
DATABASE_URL=postgresql://build:build@127.0.0.1:9/aura_build
DIRECT_URL=postgresql://build:build@127.0.0.1:9/aura_build
AUTH_SECRET=build-only-not-a-runtime-secret
NEXTAUTH_SECRET=build-only-not-a-runtime-secret
NEXTAUTH_URL=https://aura-board.com
PLAYTOKEN_JWT_SECRET=build-only-not-a-runtime-secret
