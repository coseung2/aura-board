DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=YOUR_EXACT_PUBLIC_STORAGE_BUCKET
AURA_FFMPEG_PATH=/usr/bin/ffmpeg

# Optional non-secret allowlist for exact legacy HTTPS origins, comma-separated.
# AURA_LEGACY_VIDEO_SOURCE_ORIGINS=https://legacy-media.example.com
