# Required. Use the Supabase Postgres connection string; keep this file root-only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
OCI_NAMESPACE="YOUR_OCI_OBJECT_STORAGE_NAMESPACE"
OCI_BUCKET_NAME="YOUR_PRIVATE_BUCKET_NAME"
OCI_REGION="ap-osaka-1"

# Optional.
OCI_OBJECT_PREFIX="aura-board/postgres"
PG_DUMP_BIN="/usr/bin/pg_dump"
PG_RESTORE_BIN="/usr/bin/pg_restore"
OCI_BIN="/usr/local/bin/oci"
