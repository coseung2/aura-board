# Non-secret source label. Keep it synchronized with DATABASE_URL. A missing
# value is treated as managed-supabase for legacy installations only.
# Before cutover: managed-supabase. After cutover: oracle-self-hosted.
BACKUP_SOURCE="managed-supabase"

# Required secret, injected out-of-band; keep the installed file root-only.
# Before cutover this must be the direct managed-Supabase PostgreSQL endpoint.
# After cutover it must be the local/self-hosted primary PostgreSQL endpoint,
# not a transaction pooler or a DR subscriber.
DATABASE_URL="<INJECTED_POSTGRES_CONNECTION_URL>"
OCI_NAMESPACE="YOUR_OCI_OBJECT_STORAGE_NAMESPACE"
OCI_BUCKET_NAME="YOUR_PRIVATE_BUCKET_NAME"
OCI_REGION="ap-osaka-1"

# Optional.
OCI_OBJECT_PREFIX="aura-board/postgres"
PG_DUMP_BIN="/usr/bin/pg_dump"
PG_RESTORE_BIN="/usr/bin/pg_restore"
OCI_BIN="/usr/local/bin/oci"
