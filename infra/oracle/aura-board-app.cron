SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=UTC

* * * * * aura-app /opt/aura-board-app/bin/run-app-cron.sh notification-push GET
* * * * * aura-app /opt/aura-board-app/bin/run-app-cron.sh play-outbox POST
0 0 * * 1 aura-app /opt/aura-board-app/bin/run-app-cron.sh parent-weekly-digest GET
5 15 * * * aura-app /opt/aura-board-app/bin/run-app-cron.sh fd-maturity GET
10 15 * * * aura-app /opt/aura-board-app/bin/run-app-cron.sh role-salary-payout GET
30 15 * * * aura-app /opt/aura-board-app/bin/run-app-cron.sh parent-anonymize GET
0 17 * * * aura-app /opt/aura-board-app/bin/run-app-cron.sh expire-pending-links GET
0 18 * * * aura-app /opt/aura-board-app/bin/run-app-cron.sh billing-renew POST
20 18 * * * aura-app /opt/aura-board-app/bin/run-app-cron.sh blob-cleanup GET
0 23 * * * aura-app /opt/aura-board-app/bin/run-app-cron.sh attendance-reminder GET
