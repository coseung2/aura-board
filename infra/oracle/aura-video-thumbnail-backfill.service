[Unit]
Description=Aura Board video thumbnail backfill
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=aura-media
Group=aura-media
SupplementaryGroups=aura-workers
Environment=NODE_ENV=production
EnvironmentFile=/etc/aura-board/oracle-video-thumbnail.env
WorkingDirectory=/opt/aura-board
ExecStart=/usr/bin/flock --nonblock --exclusive /run/lock/aura-board-heavy.lock /opt/aura-board/node_modules/.bin/tsx /opt/aura-board/scripts/backfill-video-thumbnails.ts --write --limit=500 --concurrency=1 --download-timeout-ms=300000 --ffmpeg-timeout-ms=120000 --max-source-bytes=1073741824
TimeoutStartSec=6h
MemoryHigh=6G
MemoryMax=8G
CPUQuota=180%
TasksMax=128
Nice=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
