[Unit]
Description=Aura Board authoritative play engine
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aura-app
Group=aura-app
Environment=PLAY_ENGINE_BIND=127.0.0.1:8081
Environment=PLAY_ENGINE_DB_MAX_CONNECTIONS=16
EnvironmentFile=/etc/aura-board/app.env
ExecStart=/opt/aura-board-play-engine/current/play-server
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30
TimeoutStopSec=30
MemoryHigh=1G
MemoryMax=2G
CPUQuota=150%
CPUAccounting=true
MemoryAccounting=true
TasksMax=256
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
