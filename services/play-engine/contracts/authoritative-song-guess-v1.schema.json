{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.example/contracts/authoritative-song-guess-v1.schema.json",
  "title": "Aura Board authoritative song-guess v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "boardId",
    "gameKind",
    "version",
    "serverTimeMs",
    "rulesVersion",
    "stateSchemaVersion",
    "previousSessionId",
    "phase",
    "currentRound",
    "participants",
    "viewer"
  ],
  "properties": {
    "sessionId": { "type": "string", "minLength": 1 },
    "boardId": { "type": "string", "minLength": 1 },
    "gameKind": { "const": "song-guess" },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "serverTimeMs": { "type": "integer" },
    "rulesVersion": { "const": 1 },
    "stateSchemaVersion": { "const": 1 },
    "previousSessionId": { "type": ["string", "null"] },
    "phase": {
      "type": "string",
      "enum": ["draft", "lobby", "guessing", "reveal", "finished"]
    },
    "currentRound": { "$ref": "#/$defs/currentRound" },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/participant" }
    },
    "viewer": { "$ref": "#/$defs/viewer" }
  },
  "$defs": {
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "tierMs", "mimeType", "durationMs", "sizeBytes"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "tierMs": { "type": "integer", "enum": [500, 1000, 1500] },
        "mimeType": { "type": "string", "enum": ["audio/wav", "audio/mp4", "audio/webm", "audio/ogg"] },
        "durationMs": { "type": "integer", "minimum": 450, "maximum": 1550 },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      }
    },
    "currentRound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roundId", "order", "accessibilityClue", "revealedAnswer", "currentClip"],
      "properties": {
        "roundId": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "accessibilityClue": { "type": ["string", "null"], "maxLength": 500 },
        "revealedAnswer": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "currentClip": {
          "oneOf": [{ "$ref": "#/$defs/clip" }, { "type": "null" }]
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "score", "scoredCurrentRound"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "score": { "type": "integer", "minimum": 0 },
        "scoredCurrentRound": { "type": "boolean" }
      }
    },
    "viewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "scoredCurrentRound"],
      "properties": {
        "role": { "type": "string", "enum": ["host", "participant"] },
        "scoredCurrentRound": { "type": "boolean" }
      }
    }
  }
}
