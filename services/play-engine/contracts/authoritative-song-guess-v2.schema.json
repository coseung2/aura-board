{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.example/contracts/authoritative-song-guess-v2.schema.json",
  "title": "Aura Board authoritative song-guess v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "boardId",
    "gameKind",
    "version",
    "serverTimeMs",
    "rulesVersion",
    "stateSchemaVersion",
    "previousSessionId",
    "phase",
    "currentRound",
    "participants",
    "viewer"
  ],
  "properties": {
    "answerTarget": { "enum": ["title", "artist", "artist-title"] },
    "sessionId": { "type": "string", "minLength": 1 },
    "boardId": { "type": "string", "minLength": 1 },
    "gameKind": { "const": "song-guess" },
    "version": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "serverTimeMs": { "type": "integer" },
    "rulesVersion": { "const": 2 },
    "stateSchemaVersion": { "const": 2 },
    "previousSessionId": { "type": ["string", "null"] },
    "answerMode": { "type": "string", "enum": ["text", "multiple-choice"], "default": "text" },
    "phase": { "type": "string", "enum": ["draft", "lobby", "guessing", "reveal", "finished"] },
    "currentRound": { "$ref": "#/$defs/currentRound" },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/participant" }
    },
    "viewer": { "$ref": "#/$defs/viewer" }
  },
  "$defs": {
    "clip": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["assetId", "tierMs", "mimeType", "durationMs", "sizeBytes"],
          "properties": {
            "assetId": { "type": "string", "minLength": 1 },
            "tierMs": { "type": "integer", "enum": [500, 1000, 1500, 15000] },
            "mimeType": { "type": "string", "enum": ["audio/wav", "audio/mp4", "audio/webm", "audio/ogg"] },
            "durationMs": { "type": "integer", "minimum": 450, "maximum": 15050 },
            "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["assetId", "tierMs", "mimeType", "durationMs", "sizeBytes"],
          "properties": {
            "assetId": { "type": "string", "minLength": 1 },
            "tierMs": { "const": 15000 },
            "mimeType": { "const": "video/youtube" },
            "durationMs": { "const": 15000 },
            "sizeBytes": { "const": 0 }
          }
        }
      ]
    },
    "currentRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roundId",
        "order",
        "accessibilityClue",
        "revealedAnswer",
        "currentClip",
        "startedAtMs",
        "deadlineAtMs",
        "maxScore"
      ],
      "properties": {
        "choices": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "label": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          }
        },
        "roundId": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "accessibilityClue": { "type": ["string", "null"], "maxLength": 500 },
        "revealedAnswer": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "currentClip": { "oneOf": [{ "$ref": "#/$defs/clip" }, { "type": "null" }] },
        "startedAtMs": { "type": ["integer", "null"] },
        "deadlineAtMs": { "type": ["integer", "null"] },
        "maxScore": { "type": "integer", "minimum": 1 }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "score", "scoredCurrentRound"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "score": { "type": "integer", "minimum": 0 },
        "scoredCurrentRound": { "type": "boolean" },
        "joined": { "type": "boolean" },
        "roundScore": { "type": "integer", "minimum": 0 },
        "previousRank": { "type": "integer", "minimum": 1 },
        "participantId": { "type": "string", "minLength": 1 },
        "representativePet": {
          "oneOf": [
            { "$ref": "#/$defs/representativePet" },
            { "type": "null" }
          ]
        }
      }
    },
    "representativePet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "growthStage", "equippedItemKeys", "hiddenItemKeys", "equippedTitleKey"],
      "properties": {
        "color": { "type": "string", "minLength": 1 },
        "growthStage": { "type": "integer", "enum": [1, 2, 3] },
        "equippedItemKeys": { "type": "array", "items": { "type": "string" } },
        "hiddenItemKeys": { "type": "array", "items": { "type": "string" } },
        "equippedTitleKey": { "type": ["string", "null"] }
      }
    },
    "viewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "scoredCurrentRound"],
      "properties": {
        "answeredCurrentRound": { "type": "boolean" },
        "selectedChoiceId": { "type": ["string", "null"], "minLength": 1 },
        "role": { "type": "string", "enum": ["host", "participant"] },
        "scoredCurrentRound": { "type": "boolean" },
        "joined": { "type": "boolean" },
        "participantIndex": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
